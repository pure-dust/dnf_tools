{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dnf_tools",
  "version": "0.1.0",
  "identifier": "com.kamilee.dnf_tools",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "dnf_tools",
        "width": 1080,
        "height": 720,
        "center": true,
        "decorations": false,
        "shadow": true,
        "transparent": true,
        "windowEffects": {
          "color": "#00000000",
          "effects": ["acrylic"]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
